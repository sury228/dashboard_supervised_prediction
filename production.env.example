# Production Environment Configuration Template
# Copy to .env and fill in actual values
# NEVER commit .env to git repository

# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py

# ⚠️ CRITICAL: Set a secure random key in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-key-here-CHANGE-THIS

# Server
PORT=5000
WORKERS=4

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Upload & Storage
UPLOAD_FOLDER=uploads
MODEL_FOLDER=models
MAX_FILE_SIZE_MB=50

# Database (for future use - not yet implemented)
# DATABASE_URL=postgresql://user:password@localhost:5432/ml_dashboard
# SQLALCHEMY_TRACK_MODIFICATIONS=False

# Optional: External Services
# SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
# ROLLBAR_ACCESS_TOKEN=your-rollbar-token
