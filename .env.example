# Flask Environment Configuration
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=your-secure-random-key-here-change-in-production

# Server Configuration
PORT=5000
WORKERS=4

# Logging
LOG_LEVEL=INFO

# Upload Configuration
UPLOAD_FOLDER=uploads
MODEL_FOLDER=models
MAX_FILE_SIZE_MB=50

# Database (if needed for future expansion)
# DATABASE_URL=postgresql://user:password@localhost/ml_dashboard
